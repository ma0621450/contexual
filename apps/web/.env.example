# Auth (middleware JWT verification only — must match apps/api)
JWT_SECRET="dev-jwt-secret-change-in-production"
ACCESS_TOKEN_EXPIRY="15m"

# Nest API (server-side fetches from Next.js server components)
INTERNAL_API_URL="http://localhost:3001"

# Short server/proxy timeouts keep API outages controlled without discarding
# valid refresh cookies.
API_SERVER_TIMEOUT_MS="3000"
API_PROXY_TIMEOUT_MS="3000"
