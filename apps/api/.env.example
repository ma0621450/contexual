DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contexual_dev"
JWT_SECRET="dev-jwt-secret-change-in-production"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY_DAYS="30"
PORT=3001
WEB_URL="http://localhost:3000"

# 32-byte key (64 hex chars) used to encrypt organization provider API keys (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-characters"

# Stripe billing (test mode). Leave blank to disable billing.
# Secret key: Stripe Dashboard > Developers > API keys (starts with sk_test_)
STRIPE_SECRET_KEY=""
# Webhook signing secret. Local: `stripe listen --forward-to localhost:3001/api/billing/webhook` (starts with whsec_)
STRIPE_WEBHOOK_SECRET=""
# Recurring Price IDs for each paid plan (create Products/Prices in Stripe, copy the price_... IDs)
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# Email (Resend). Leave blank to log emails to the API console in dev.
# API key: Resend Dashboard > API Keys (starts with re_)
RESEND_API_KEY=""
# Verified sender, e.g. "Contexual <onboarding@yourdomain.com>" or Resend sandbox
EMAIL_FROM=""
