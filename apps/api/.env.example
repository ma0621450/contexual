NODE_ENV="development"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/contexual_dev"
# Production requires a random value of at least 32 characters. This dev value
# is rejected when NODE_ENV=production.
JWT_SECRET="dev-jwt-secret-change-in-production"
ACCESS_TOKEN_EXPIRY="15m"
REFRESH_TOKEN_EXPIRY_DAYS="30"
PORT=3001
# Production requires the public HTTPS web origin.
WEB_URL="http://localhost:3000"
# Platform admin origin. Must be a different origin from WEB_URL so staff and
# customer sessions never share a cookie jar.
ADMIN_URL="http://localhost:3002"

# Used only by `npm run platform:seed` to create the first OWNER on a fresh
# installation. PLATFORM_SEED_PASSWORD is optional outside production, where a
# temporary password is generated and printed once instead; production refuses
# to seed without one and rejects weak values. The seeded account cannot reach
# the console until the password is changed at first sign-in.
PLATFORM_SEED_EMAIL="owner@example.com"
PLATFORM_SEED_NAME="Platform Owner"
# PLATFORM_SEED_PASSWORD=""

# Development-only 32-byte key used to encrypt organization provider API keys.
# Generate a unique production value with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Stripe billing (test mode). Leave blank to disable billing.
# Secret key: Stripe Dashboard > Developers > API keys (starts with sk_test_)
STRIPE_SECRET_KEY=""
# Webhook signing secret. Local: `stripe listen --forward-to localhost:3001/api/billing/webhook` (starts with whsec_)
STRIPE_WEBHOOK_SECRET=""
# Recurring Price IDs for each paid plan (create Products/Prices in Stripe, copy the price_... IDs)
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
STRIPE_PRICE_BUSINESS=""

# Email (Resend). Both values are mandatory in production. When absent in
# development, only recipient and subject are logged (never OTPs or links).
# API key: Resend Dashboard > API Keys (starts with re_)
RESEND_API_KEY=""
# Verified sender, e.g. "Contexual <onboarding@yourdomain.com>" or Resend sandbox
EMAIL_FROM=""
EMAIL_TIMEOUT_MS="10000"
EMAIL_MAX_ATTEMPTS="5"
EMAIL_WORKER_POLL_MS="1000"
EMAIL_STALE_LOCK_MS="300000"

# S3-compatible file storage (AWS S3, Cloudflare R2, MinIO).
# Leave S3_BUCKET blank for local development storage in LOCAL_UPLOAD_DIR.
# Production requires a non-local durable bucket and region. Credentials can be
# omitted only when the runtime supplies an IAM/workload identity.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
LOCAL_UPLOAD_DIR=".uploads"

# Quarantined file processing. Scanning fails closed by default.
# A local-only bypass requires explicitly setting FILE_SCANNING_REQUIRED=false;
# the API refuses to start with that value in production.
FILE_SCANNING_REQUIRED="true"
# Use "clamav" when running through compose.yaml.
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
CLAMAV_TIMEOUT_MS="30000"
MAX_FILE_BYTES="25000000"
FILE_EXTRACTION_TIMEOUT_MS="30000"
FILE_MAX_EXTRACTED_CHARACTERS="1000000"
FILE_MAX_PAGES="100"
FILE_JOB_STALE_LOCK_MS="600000"
FILE_WORKER_POLL_MS="1000"
