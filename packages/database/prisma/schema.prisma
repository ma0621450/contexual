generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ADMIN
  MEMBER
}

/// Platform staff access, entirely separate from tenant membership roles.
enum PlatformRole {
  SUPPORT
  OPERATOR
  OWNER
}

enum PlanTier {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  XAI
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum MemoryScope {
  USER
  ORGANIZATION
}

enum UsageReservationStatus {
  PENDING
  COMPLETED
  RELEASED
}

enum FileProcessingStatus {
  PENDING_SCAN
  SCANNING
  EXTRACTING
  READY
  QUARANTINED
  FAILED
}

enum FileProcessingJobStatus {
  PENDING
  PROCESSING
  RETRY
  COMPLETED
  FAILED
}

enum OrganizationType {
  DESIGN_AGENCY
  CREATIVE_STUDIO
  BRAND_CONSULTANCY
  UX_RESEARCH_FIRM
}

enum TeamSize {
  JUST_ME
  SIZE_2_10
  SIZE_11_25
  SIZE_26_100
  SIZE_100_PLUS
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  RETRY
  SENT
  FAILED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  emailVerifiedAt DateTime?
  sessionVersion  Int      @default(0)

  emailVerificationOtpHash      String?
  emailVerificationOtpExpiresAt DateTime?
  emailVerificationOtpSentAt    DateTime?
  passwordResetTokenHash        String?
  passwordResetTokenExpiresAt   DateTime?

  activeOrganizationId String?
  activeOrganization   Organization? @relation("ActiveOrg", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  memberships     Membership[]
  conversations   Conversation[]
  memories        Memory[]
  uploadedFiles   StoredFile[]
  auditLogs       AuditLog[]       @relation("AuditActor")
  sentInvites     Invite[]         @relation("InviteSender")
  refreshTokens   RefreshToken[]
  connectedProviders OrganizationProvider[]
  impersonations  ImpersonationGrant[] @relation("ImpersonationTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Organization {
  id   String @id @default(cuid())
  name String
  /// Workspace URL identifier.
  slug String @unique
  organizationType OrganizationType?
  teamSize         TeamSize?

  planTier  PlanTier @default(FREE)
  maxMembers Int     @default(3)
  monthlySpendLimitCents Int? @default(0)
  monthlySpendUsedCents  Int  @default(0)
  monthlyTokenLimit      Int? @default(0)
  monthlyTokensUsed      Int  @default(0)
  usagePeriodStartedAt   DateTime @default(now())

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String?

  memberships   Membership[]
  conversations Conversation[]
  memories      Memory[]
  files         StoredFile[]
  invites       Invite[]
  auditLogs     AuditLog[]
  activeUsers   User[]        @relation("ActiveOrg")
  stripeEvents  StripeEvent[]
  usageLogs     UsageLog[]
  usageReservations UsageReservation[]
  fileProcessingJobs FileProcessingJob[]
  providers     OrganizationProvider[]
  impersonationGrants ImpersonationGrant[]

  storageBytesUsed BigInt @default(0)
  storedFileCount  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model OrganizationProvider {
  id               String     @id @default(cuid())
  organizationId   String
  provider         AiProvider
  apiKeyCiphertext String
  apiKeyIv         String
  defaultModel     String
  /// Model IDs from the curated catalog that members may use for this provider.
  enabledModels    String[]   @default([])
  connectedById    String?
  connectedAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?        @relation(fields: [connectedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@index([connectedById])
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)

  spendLimitCents     Int?     @default(0)
  spendUsedCents       Int     @default(0)
  tokenLimit           Int?    @default(0)
  tokensUsed           Int     @default(0)
  spendPeriodStartedAt DateTime @default(now())

  suspended Boolean @default(false)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usageReservations UsageReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Invite {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  role           MembershipRole @default(MEMBER)
  status         InviteStatus @default(PENDING)
  token          String       @unique
  /// SHA-256 of a secret delivered only inside the invitation email; proves inbox control.
  emailProofHash String?

  invitedById String
  invitedBy   User   @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
}

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String

  title    String  @default("New Conversation")
  provider AiProvider
  model    String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages  Message[]
  usageLogs UsageLog[]

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, userId])
  @@index([organizationId, userId, updatedAt])
}

model Memory {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?
  scope          MemoryScope @default(USER)
  title          String
  content        String      @db.Text
  enabled        Boolean     @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, scope, enabled])
  @@index([organizationId, userId, enabled])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole

  content String @db.Text
  metadata Json?

  promptTokens     Int?
  completionTokens Int?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model StoredFile {
  id                  String               @id @default(cuid())
  organizationId      String
  uploadedById        String
  filename            String
  mimeType            String
  detectedMimeType    String?
  sizeBytes           Int
  storageKey          String               @unique
  sha256              String?
  processingStatus    FileProcessingStatus @default(PENDING_SCAN)
  scanBypassed        Boolean              @default(false)
  scanStartedAt       DateTime?
  scannedAt           DateTime?
  extractionStartedAt DateTime?
  extractedAt         DateTime?
  failureCode         String?
  failureMessage      String?
  extractedText       String?              @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]
  processingJob FileProcessingJob?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, uploadedById])
  @@index([organizationId, processingStatus])
}

model FileProcessingJob {
  id               String                  @id @default(cuid())
  fileId           String                  @unique
  organizationId   String
  status           FileProcessingJobStatus @default(PENDING)
  attempts         Int                     @default(0)
  maxAttempts      Int                     @default(5)
  runAfter         DateTime                @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  lastErrorCode    String?
  lastErrorMessage String?
  completedAt      DateTime?

  file         StoredFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAfter])
  @@index([organizationId, status, runAfter])
  @@index([lockedAt])
}

model MessageAttachment {
  messageId String
  fileId    String

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([messageId, fileId])
  @@index([fileId])
}

model UsageLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  conversationId String?

  provider         AiProvider
  model            String
  promptTokens     Int
  completionTokens Int
  estimatedCostCents Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, createdAt])
}

model UsageReservation {
  id                String                 @id @default(cuid())
  organizationId    String
  membershipId      String
  requestId         String                 @unique
  reservedTokens    Int
  reservedCostCents Int
  status            UsageReservationStatus @default(PENDING)
  expiresAt         DateTime
  createdAt         DateTime               @default(now())
  completedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, expiresAt])
  @@index([membershipId, status, expiresAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?

  action  String
  details Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Platform staff, with credentials of their own and no relation to User. A
/// customer-facing flow such as password reset must never be able to reach a
/// staff credential, and staff must not appear in tenant-facing tables.
///
/// One row per person: PlatformAuditLog and ImpersonationGrant attribute every
/// action to a specific admin, which is meaningless if logins are shared.
model PlatformAdmin {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         PlatformRole @default(SUPPORT)

  /// Set on seeded or reset accounts. Blocks every platform route except the
  /// rotation endpoint until a new password is chosen.
  mustChangePassword Boolean @default(false)

  /// Reserved for a future identity provider. Nothing writes it yet; it exists
  /// so adopting SSO does not require another migration on this table.
  ssoSubject String? @unique

  totpSecretCiphertext String?
  totpSecretIv         String?
  totpConfirmedAt      DateTime?

  lastLoginAt DateTime?
  disabledAt  DateTime?

  auditLogs           PlatformAuditLog[]
  impersonationGrants ImpersonationGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Staff actions across the whole platform. Kept apart from the per-tenant
/// AuditLog, whose organizationId is required and whose feed customers read.
model PlatformAuditLog {
  id              String  @id @default(cuid())
  platformAdminId String?

  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipAddress  String?

  platformAdmin PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([platformAdminId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model ImpersonationGrant {
  id                   String @id @default(cuid())
  platformAdminId      String
  targetUserId         String
  targetOrganizationId String

  reason String @db.Text

  /// Single-use handoff token that exchanges platform auth for a scoped
  /// application session on the customer-facing origin.
  redeemTokenHash String    @unique
  redeemedAt      DateTime?
  expiresAt       DateTime
  endsAt          DateTime
  endedAt         DateTime?

  platformAdmin      PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)
  targetUser         User          @relation("ImpersonationTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetOrganization Organization  @relation(fields: [targetOrganizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([platformAdminId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([targetOrganizationId, createdAt])
}

model StripeEvent {
  id             String   @id
  organizationId String?
  type           String
  processedAt    DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([type])
}

model EmailOutbox {
  id             String            @id @default(cuid())
  idempotencyKey String            @unique
  to             String
  subject        String
  html           String            @db.Text
  text           String            @db.Text
  status         EmailOutboxStatus @default(PENDING)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5)
  runAfter       DateTime          @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  providerId     String?
  lastError      String?
  sentAt         DateTime?
  /// Set once html/text are cleared after delivery finishes; bodies carry one-time secrets.
  contentRedactedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, runAfter])
  @@index([lockedAt])
}

/// Fixed-window counters shared by every API instance. Keys hold hashed subjects only.
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
