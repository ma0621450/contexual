generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ADMIN
  MEMBER
}

enum PlanTier {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum AiProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  XAI
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum MemoryScope {
  USER
  ORGANIZATION
}

enum UsageReservationStatus {
  PENDING
  COMPLETED
  RELEASED
}

enum FileProcessingStatus {
  PENDING_SCAN
  SCANNING
  EXTRACTING
  READY
  QUARANTINED
  FAILED
}

enum FileProcessingJobStatus {
  PENDING
  PROCESSING
  RETRY
  COMPLETED
  FAILED
}

enum EmailOutboxStatus {
  PENDING
  PROCESSING
  RETRY
  SENT
  FAILED
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  name            String
  emailVerifiedAt DateTime?
  sessionVersion  Int      @default(0)

  emailVerificationOtpHash      String?
  emailVerificationOtpExpiresAt DateTime?
  emailVerificationOtpSentAt    DateTime?
  passwordResetTokenHash        String?
  passwordResetTokenExpiresAt   DateTime?

  activeOrganizationId String?
  activeOrganization   Organization? @relation("ActiveOrg", fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  memberships     Membership[]
  conversations   Conversation[]
  chatFolders     ChatFolder[]
  memories        Memory[]
  uploadedFiles   StoredFile[]
  auditLogs       AuditLog[]       @relation("AuditActor")
  sentInvites     Invite[]         @relation("InviteSender")
  refreshTokens   RefreshToken[]
  connectedProviders OrganizationProvider[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

model Organization {
  id   String @id @default(cuid())
  name String
  slug String @unique

  planTier  PlanTier @default(FREE)
  maxMembers Int     @default(3)
  monthlySpendLimitCents Int? @default(0)
  monthlySpendUsedCents  Int  @default(0)
  monthlyTokenLimit      Int? @default(0)
  monthlyTokensUsed      Int  @default(0)
  usagePeriodStartedAt   DateTime @default(now())

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String?

  memberships   Membership[]
  conversations Conversation[]
  chatFolders   ChatFolder[]
  memories      Memory[]
  files         StoredFile[]
  invites       Invite[]
  auditLogs     AuditLog[]
  activeUsers   User[]        @relation("ActiveOrg")
  stripeEvents  StripeEvent[]
  usageLogs     UsageLog[]
  usageReservations UsageReservation[]
  fileProcessingJobs FileProcessingJob[]
  providers     OrganizationProvider[]

  storageBytesUsed BigInt @default(0)
  storedFileCount  Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model OrganizationProvider {
  id               String     @id @default(cuid())
  organizationId   String
  provider         AiProvider
  apiKeyCiphertext String
  apiKeyIv         String
  defaultModel     String
  /// Model IDs from the curated catalog that members may use for this provider.
  enabledModels    String[]   @default([])
  connectedById    String?
  connectedAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedBy  User?        @relation(fields: [connectedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId])
  @@index([connectedById])
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)

  spendLimitCents     Int?     @default(0)
  spendUsedCents       Int     @default(0)
  tokenLimit           Int?    @default(0)
  tokensUsed           Int     @default(0)
  spendPeriodStartedAt DateTime @default(now())

  suspended Boolean @default(false)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  usageReservations UsageReservation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Invite {
  id             String       @id @default(cuid())
  email          String
  organizationId String
  role           MembershipRole @default(MEMBER)
  status         InviteStatus @default(PENDING)
  token          String       @unique

  invitedById String
  invitedBy   User   @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([email])
}

model ChatFolder {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  name           String
  instructions   String? @db.Text
  defaultModel   String?

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  files         ChatFolderFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, userId])
}

model ChatFolderFile {
  folderId String
  fileId   String

  folder ChatFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  file   StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([folderId, fileId])
  @@index([fileId])
}

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  userId         String

  title    String  @default("New Conversation")
  provider AiProvider
  model    String
  folderId String?
  pinnedAt DateTime?
  instructions String? @db.Text
  shareToken      String?   @unique
  isShared        Boolean   @default(false)
  shareExpiresAt  DateTime?
  activeLeafId    String?
  webSearchEnabled Boolean @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder       ChatFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)

  messages  Message[]
  usageLogs UsageLog[]

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, userId])
  @@index([organizationId, userId, updatedAt])
  @@index([organizationId, shareToken])
  @@index([folderId])
}

model Memory {
  id             String      @id @default(cuid())
  organizationId String
  userId         String?
  scope          MemoryScope @default(USER)
  title          String
  content        String      @db.Text
  enabled        Boolean     @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, scope, enabled])
  @@index([organizationId, userId, enabled])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  parentId       String?
  role           MessageRole

  content String @db.Text
  metadata Json?

  promptTokens     Int?
  completionTokens Int?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent       Message?     @relation("MessageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Message[]    @relation("MessageTree")
  attachments MessageAttachment[]

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, parentId])
}

model StoredFile {
  id                  String               @id @default(cuid())
  organizationId      String
  uploadedById        String
  filename            String
  mimeType            String
  detectedMimeType    String?
  sizeBytes           Int
  storageKey          String               @unique
  sha256              String?
  processingStatus    FileProcessingStatus @default(PENDING_SCAN)
  scanBypassed        Boolean              @default(false)
  scanStartedAt       DateTime?
  scannedAt           DateTime?
  extractionStartedAt DateTime?
  extractedAt         DateTime?
  failureCode         String?
  failureMessage      String?
  extractedText       String?              @db.Text
  embedding           Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]
  processingJob FileProcessingJob?
  folderLinks   ChatFolderFile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, uploadedById])
  @@index([organizationId, processingStatus])
}

model FileProcessingJob {
  id               String                  @id @default(cuid())
  fileId           String                  @unique
  organizationId   String
  status           FileProcessingJobStatus @default(PENDING)
  attempts         Int                     @default(0)
  maxAttempts      Int                     @default(5)
  runAfter         DateTime                @default(now())
  lockedAt         DateTime?
  lockedBy         String?
  lastErrorCode    String?
  lastErrorMessage String?
  completedAt      DateTime?

  file         StoredFile   @relation(fields: [fileId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAfter])
  @@index([organizationId, status, runAfter])
  @@index([lockedAt])
}

model MessageAttachment {
  messageId String
  fileId    String

  message Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@id([messageId, fileId])
  @@index([fileId])
}

model UsageLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  conversationId String?

  provider         AiProvider
  model            String
  promptTokens     Int
  completionTokens Int
  estimatedCostCents Int

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, createdAt])
}

model UsageReservation {
  id                String                 @id @default(cuid())
  organizationId    String
  membershipId      String
  requestId         String                 @unique
  reservedTokens    Int
  reservedCostCents Int
  status            UsageReservationStatus @default(PENDING)
  expiresAt         DateTime
  createdAt         DateTime               @default(now())
  completedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, expiresAt])
  @@index([membershipId, status, expiresAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?

  action  String
  details Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StripeEvent {
  id             String   @id
  organizationId String?
  type           String
  processedAt    DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([type])
}

model EmailOutbox {
  id             String            @id @default(cuid())
  idempotencyKey String            @unique
  to             String
  subject        String
  html           String            @db.Text
  text           String            @db.Text
  status         EmailOutboxStatus @default(PENDING)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5)
  runAfter       DateTime          @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  providerId     String?
  lastError      String?
  sentAt         DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([status, runAfter])
  @@index([lockedAt])
}
